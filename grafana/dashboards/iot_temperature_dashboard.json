      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB-IoT"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  bucket AS \"time\",\n  CONCAT('Sensor ', sensor_id) AS metric,\n  avg_temp AS value\nFROM sensor_hourly_cagg\nWHERE $__timeFilter(bucket)\n  AND sensor_id IN ($sensor_filter)\nORDER BY 1, 2;",
          "refId": "A"
        }
      ],
      "title": "Hourly Average Temperature (TimescaleDB Continuous Aggregate: sensor_hourly_cagg)",
      "type": "timeseries"
