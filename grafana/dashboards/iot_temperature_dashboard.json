          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  bucket AS \"time\",\n  CONCAT('Sensor ', sensor_id) AS metric,\n  AVG(battery_level) AS value\nFROM (\n  SELECT time_bucket('1 hour', time) AS bucket, sensor_id, battery_level\n  FROM sensor_data_ts\n  WHERE $__timeFilter(time)\n    AND sensor_id IN ($sensor_filter)\n) sub\nGROUP BY 1, 2\nORDER BY 1;",
