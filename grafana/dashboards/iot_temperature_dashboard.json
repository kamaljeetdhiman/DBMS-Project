      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB-IoT"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  sensor_id,\n  ROUND(AVG(avg_temp)::numeric, 2) AS mean_temp,\n  ROUND(MIN(min_temp)::numeric, 2) AS min_temp,\n  ROUND(MAX(max_temp)::numeric, 2) AS max_temp,\n  ROUND(AVG(avg_humidity)::numeric, 2) AS mean_humidity,\n  SUM(sample_count) AS total_samples\nFROM sensor_hourly_cagg\nGROUP BY sensor_id\nORDER BY sensor_id;",
          "refId": "A"
        }
      ],
      "title": "Sensor Statistical Synthesis (from Continuous Aggregates)",
      "type": "table"
